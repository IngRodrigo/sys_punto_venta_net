<UserControl x:Class="SysPuntoVenta.Frontend.Views.FacturacionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera de Página Minimalista -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="FACTURACIÓN Y PUNTO DE VENTA" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="Emisión de comprobantes con cálculo automático de IVA 10% y descuento de stock" 
                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Datos del Cliente y Selección de Producto -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.9*" />
            </Grid.ColumnDefinitions>

            <!-- Tarjeta Cliente Compacta -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurfaceCard}" Margin="0,0,8,0" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="● CLIENTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,8" />
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="RUC / C.I. (Enter)" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtDocumentoCliente" Text="4444444-1" Height="29" KeyDown="TxtDocumentoCliente_KeyDown" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text=" " FontSize="10.5" Margin="0,0,0,3" />
                            <Button Style="{DynamicResource BtnOutline}" Height="29" Padding="10,0" Click="BtnBuscarCliente_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="Buscar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Razón Social / Nombre" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                    <TextBox x:Name="txtNombreCliente" Text="Consumidor Final" Height="29" />
                </StackPanel>
            </Border>

            <!-- Tarjeta Agregar Producto Compacta -->
            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceCard}" Margin="8,0,0,0" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="● AGREGAR ARTÍCULO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushCyan}" Margin="0,0,0,8" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Código / Enter -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Código (Enter)" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtCodigoProducto" Height="29" KeyDown="TxtCodigoProducto_KeyDown" />
                        </StackPanel>

                        <!-- Botón Buscar -->
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text=" " FontSize="10.5" Margin="0,0,0,3" />
                            <Button Style="{DynamicResource BtnOutline}" Height="29" Padding="10,0" Click="BtnBuscarProducto_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="Buscar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Descripción Producto Seleccionado -->
                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                            <TextBlock Text="Descripción" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtDescripcionProducto" Height="29" IsReadOnly="True" />
                        </StackPanel>

                        <!-- Cantidad -->
                        <StackPanel Grid.Column="3" Margin="0,0,6,0">
                            <TextBlock Text="Cant." FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtCantidad" Text="1" Height="29" TextAlignment="Center" KeyDown="TxtCantidad_KeyDown" />
                        </StackPanel>

                        <!-- Botón Agregar -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text=" " FontSize="10.5" Margin="0,0,0,3" />
                            <Button x:Name="btnAgregarProducto" Style="{DynamicResource BtnPrimary}" Height="29" Padding="12,0" Click="BtnAgregarProducto_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" Margin="0,0,4,0" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="Agregar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Info de Stock -->
                    <TextBlock x:Name="lblInfoStock" Text="Selecciona o digita un producto para agregarlo." FontSize="10" Foreground="{DynamicResource BrushCyan}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Detalle de Factura (Grilla) -->
        <Border Grid.Row="2" Background="{DynamicResource BrushSurfaceCard}" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <DataGrid x:Name="dgDetalle" RowHeight="28" FontSize="11.5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="DESCRIPCIÓN DEL ARTÍCULO" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad}" Width="85" />
                    <DataGridTextColumn Header="PRECIO UNIT." Binding="{Binding PrecioUnitario, StringFormat={}{0:N0} Gs}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat={}{0:N0} Gs}" Width="130" IsReadOnly="True" />
                    
                    <!-- Botón Eliminar Fila -->
                    <DataGridTemplateColumn Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕ Quitar" Foreground="{DynamicResource BrushDanger}" BorderBrush="{DynamicResource BrushDanger}" Style="{DynamicResource BtnOutline}" FontSize="10" Padding="4,1" Height="22" Click="BtnEliminarDetalle_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Barra Inferior de Liquidación y Totales -->
        <Border Grid.Row="3" Background="{DynamicResource BrushSurfaceCard}" Margin="0,12,0,0" Padding="16,10" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Botones de Acción -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Limpiar Venta" Style="{DynamicResource BtnOutline}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnLimpiar_Click" />
                    <Button x:Name="btnEmitirFactura" Style="{DynamicResource BtnPrimary}" Height="32" Padding="16,0" Click="BtnEmitirFactura_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="EMITIR FACTURA" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Totales Compactos -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Subtotal Bruto -->
                    <Border Background="{DynamicResource BrushBadgeBackground}" CornerRadius="5" Padding="10,5" Margin="0,0,8,0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SUBTOTAL BRUTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock x:Name="lblTotalBruto" Text="0 Gs." FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                        </StackPanel>
                    </Border>

                    <!-- Liquidación IVA 10% -->
                    <Border Background="{DynamicResource BrushBadgeBackground}" CornerRadius="5" Padding="10,5" Margin="0,0,8,0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LIQUIDACIÓN IVA 10%" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushCyan}" />
                            <TextBlock x:Name="lblTotalImpuesto" Text="0 Gs." FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushCyan}" />
                        </StackPanel>
                    </Border>

                    <!-- Total Neto -->
                    <Border Background="{DynamicResource BrushAccentGradient}" CornerRadius="5" Padding="14,6">
                        <StackPanel>
                            <TextBlock Text="TOTAL A PAGAR" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock x:Name="lblTotalNeto" Text="0 Gs." FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
