<UserControl x:Class="SysPuntoVenta.Frontend.Views.InformesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Minimalista y Selector de Módulo -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MÓDULO DE INFORMES Y AUDITORÍA" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="Visualización de datos maestros, resumen financiero en grillas y exportación a PDF" 
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Estado o Info Rápida -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="{DynamicResource BrushSurfaceCard}" Padding="10,5" CornerRadius="5" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <TextBlock x:Name="lblStatusInforme" Text="Listo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de Pestañas: Empieza con Clientes -->
        <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceCard}" Padding="6" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTabClientes" Content="👥 Clientes" Style="{DynamicResource BtnPrimary}" Height="30" Margin="0,0,6,0" Click="BtnTabClientes_Click" />
                <Button x:Name="btnTabVentas" Content="💰 Ventas (Día, Semana, Año)" Style="{DynamicResource BtnOutline}" Height="30" Margin="0,0,6,0" Click="BtnTabVentas_Click" />
                <Button x:Name="btnTabUsuarios" Content="👤 Usuarios" Style="{DynamicResource BtnOutline}" Height="30" Margin="0,0,6,0" Click="BtnTabUsuarios_Click" />
                <Button x:Name="btnTabProductos" Content="📦 Catálogo de Productos" Style="{DynamicResource BtnOutline}" Height="30" Click="BtnTabProductos_Click" />
            </StackPanel>
        </Border>

        <!-- Contenedor Principal de Grillas -->
        <Grid Grid.Row="2">

            <!-- 1. SECCIÓN INFORMES DE CLIENTES (ACTIVA POR DEFECTO) -->
            <Grid x:Name="panelClientes" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceCard}" Padding="12,8" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Filtrar Cliente:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="txtFiltroCliente" Width="240" Height="28" TextChanged="TxtFiltroCliente_TextChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="btnExportarPdfClientes" Style="{DynamicResource BtnPrimary}" Height="28" Padding="12,0" Margin="0,0,6,0" Click="BtnExportarPdfClientes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="Exportar a PDF" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnRefrescarClientes" Content="🔄 Actualizar" Style="{DynamicResource BtnOutline}" Height="28" Click="BtnRefrescarClientes_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceCard}" Padding="10" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <DataGrid x:Name="dgClientes" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                            <DataGridTextColumn Header="Documento / RUC" Binding="{Binding Documento}" Width="130" />
                            <DataGridTextColumn Header="Nombre / Razón Social" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Teléfono / WhatsApp" Binding="{Binding Telefono}" Width="140" />
                            <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="1.4*" />
                            <DataGridTextColumn Header="Correo Electrónico" Binding="{Binding Email}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 2. SECCIÓN INFORMES DE VENTAS (DÍA, SEMANA, AÑO) -->
            <Grid x:Name="panelVentas" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filtros de Período: Día, Semana, Año -->
                <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceCard}" Padding="12,8" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,0,10">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Período de Ventas:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button x:Name="btnPeriodoDia" Content="📅 Hoy (Día)" Style="{DynamicResource BtnPrimary}" Height="28" Margin="0,0,6,0" Click="BtnPeriodoDia_Click" />
                            <Button x:Name="btnPeriodoSemana" Content="📆 Últimos 7 Días (Semana)" Style="{DynamicResource BtnOutline}" Height="28" Margin="0,0,6,0" Click="BtnPeriodoSemana_Click" />
                            <Button x:Name="btnPeriodoAnio" Content="📈 Año Actual (Año)" Style="{DynamicResource BtnOutline}" Height="28" Margin="0,0,6,0" Click="BtnPeriodoAnio_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="btnExportarPdfVentas" Style="{DynamicResource BtnPrimary}" Height="28" Padding="12,0" Margin="0,0,6,0" Click="BtnExportarPdfVentas_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="Exportar a PDF" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnRefrescarVentas" Content="🔄 Actualizar" Style="{DynamicResource BtnOutline}" Height="28" Click="BtnRefrescarVentas_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tarjetas de Resumen Financiero -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Tarjeta 1: Total Facturas -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushSurfaceCard}" Padding="12,10" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="CANTIDAD VENTAS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock x:Name="lblTotalVentasCant" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta 2: Subtotal Bruto -->
                    <Border Grid.Column="2" Background="{DynamicResource BrushSurfaceCard}" Padding="12,10" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TOTAL BRUTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock x:Name="lblTotalBruto" Text="0 Gs." FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta 3: IVA 10% -->
                    <Border Grid.Column="4" Background="{DynamicResource BrushSurfaceCard}" Padding="12,10" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="IMPUESTO IVA (10%)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushCyan}" />
                            <TextBlock x:Name="lblTotalImpuesto" Text="0 Gs." FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushCyan}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta 4: Total Neto -->
                    <Border Grid.Column="6" Background="{DynamicResource BrushSurfaceCard}" Padding="12,10" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TOTAL NETO LIQUIDADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" />
                            <TextBlock x:Name="lblTotalNeto" Text="0 Gs." FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Grilla de Ventas -->
                <Border Grid.Row="2" Background="{DynamicResource BrushSurfaceCard}" Padding="10" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <DataGrid x:Name="dgVentas" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° Factura" Binding="{Binding NumeroFactura}" Width="130" />
                            <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" />
                            <DataGridTextColumn Header="RUC / C.I." Binding="{Binding DocumentoCliente}" Width="120" />
                            <DataGridTextColumn Header="Cliente / Razón Social" Binding="{Binding NombreCliente}" Width="*" />
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding TotalBruto, StringFormat='{}{0:N0} Gs.'}" Width="120" />
                            <DataGridTextColumn Header="IVA 10%" Binding="{Binding TotalImpuesto, StringFormat='{}{0:N0} Gs.'}" Width="110" />
                            <DataGridTextColumn Header="Total Factura" Binding="{Binding TotalNeto, StringFormat='{}{0:N0} Gs.'}" Width="130" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 3. SECCIÓN INFORMES DE USUARIOS -->
            <Grid x:Name="panelUsuarios" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceCard}" Padding="12,8" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Filtrar Usuario:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="txtFiltroUsuario" Width="240" Height="28" TextChanged="TxtFiltroUsuario_TextChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="btnExportarPdfUsuarios" Style="{DynamicResource BtnPrimary}" Height="28" Padding="12,0" Margin="0,0,6,0" Click="BtnExportarPdfUsuarios_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="Exportar a PDF" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnRefrescarUsuarios" Content="🔄 Actualizar" Style="{DynamicResource BtnOutline}" Height="28" Click="BtnRefrescarUsuarios_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceCard}" Padding="10" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <DataGrid x:Name="dgUsuarios" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                            <DataGridTextColumn Header="Usuario (Login)" Binding="{Binding UserName}" Width="130" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*" />
                            <DataGridTextColumn Header="Correo Electrónico" Binding="{Binding Email}" Width="1.4*" />
                            <DataGridTextColumn Header="Rol / Perfil" Binding="{Binding Rol}" Width="130" />
                            <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 4. SECCIÓN INFORMES DE PRODUCTOS -->
            <Grid x:Name="panelProductos" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceCard}" Padding="12,8" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Filtrar Producto:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="txtFiltroProducto" Width="240" Height="28" TextChanged="TxtFiltroProducto_TextChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="btnExportarPdfProductos" Style="{DynamicResource BtnPrimary}" Height="28" Padding="12,0" Margin="0,0,6,0" Click="BtnExportarPdfProductos_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="Exportar a PDF" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnRefrescarProductos" Content="🔄 Actualizar" Style="{DynamicResource BtnOutline}" Height="28" Click="BtnRefrescarProductos_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceCard}" Padding="10" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <DataGrid x:Name="dgProductos" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                            <DataGridTextColumn Header="Código / Barra" Binding="{Binding Codigo}" Width="130" />
                            <DataGridTextColumn Header="Descripción del Producto" Binding="{Binding Descripcion}" Width="*" />
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="140" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding Cantidad}" Width="80" />
                            <DataGridTextColumn Header="Precio Bruto" Binding="{Binding Bruto, StringFormat='{}{0:N0} Gs.'}" Width="120" />
                            <DataGridTextColumn Header="Precio Venta" Binding="{Binding PrecioNeto, StringFormat='{}{0:N0} Gs.'}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
