<UserControl x:Class="SysPuntoVenta.Frontend.Views.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Minimalista Dinámico -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PANEL DE CONTROL" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="Métricas operativas del negocio en tiempo real vía API REST" 
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{DynamicResource BtnOutline}" Height="30" Padding="12,0" Click="BtnRefrescar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,5,0" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Text="Actualizar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Fila de Cards Métricas Compactas -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Cantidad de Ventas -->
            <Border Grid.Column="0" Margin="0,0,8,0" Background="{DynamicResource BrushSurfaceCard}" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="VENTAS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" />
                        <Border HorizontalAlignment="Right" Width="26" Height="26" CornerRadius="6" Background="{DynamicResource BrushCardIcon}">
                            <TextBlock Text="🛒" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="lblCantidadVentas" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,2" />
                    <TextBlock Grid.Row="2" Text="Facturas emitidas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                </Grid>
            </Border>

            <!-- Card 2: Total Recaudado -->
            <Border Grid.Column="1" Margin="4,0,4,0" Background="{DynamicResource BrushSurfaceCard}" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="TOTAL FACTURADO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushCyan}" />
                        <Border HorizontalAlignment="Right" Width="26" Height="26" CornerRadius="6" Background="{DynamicResource BrushCardIcon}">
                            <TextBlock Text="💰" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="lblTotalRecaudado" Text="0 Gs." FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushCyan}" Margin="0,6,0,2" />
                    <TextBlock Grid.Row="2" Text="Ingresos netos acumulados" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                </Grid>
            </Border>

            <!-- Card 3: Usuarios Registrados -->
            <Border Grid.Column="2" Margin="4,0,4,0" Background="{DynamicResource BrushSurfaceCard}" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="USUARIOS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" />
                        <Border HorizontalAlignment="Right" Width="26" Height="26" CornerRadius="6" Background="{DynamicResource BrushCardIcon}">
                            <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="lblCantidadUsuarios" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,2" />
                    <TextBlock Grid.Row="2" Text="Operadores activos" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                </Grid>
            </Border>

            <!-- Card 4: Clientes Cartera -->
            <Border Grid.Column="3" Margin="8,0,0,0" Background="{DynamicResource BrushSurfaceCard}" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="CLIENTES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushCyan}" />
                        <Border HorizontalAlignment="Right" Width="26" Height="26" CornerRadius="6" Background="{DynamicResource BrushCardIcon}">
                            <TextBlock Text="👥" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="lblCantidadClientes" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,2" />
                    <TextBlock Grid.Row="2" Text="Cartera registrada" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Sección Inferior: Ventas Recientes -->
        <Border Grid.Row="2" Background="{DynamicResource BrushSurfaceCard}" Padding="16,14" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="ÚLTIMAS VENTAS EMITIDAS" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" />
                    <TextBlock Text="Historial en tiempo real" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" />
                </Grid>

                <DataGrid Grid.Row="1" x:Name="dgVentasRecientes" RowHeight="28" FontSize="11.5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° FACTURA" Binding="{Binding NumeroFactura}" Width="110" />
                        <DataGridTextColumn Header="FECHA / HORA" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="130" />
                        <DataGridTextColumn Header="DOC. CLIENTE" Binding="{Binding DocumentoCliente}" Width="115" />
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding NombreCliente}" Width="*" />
                        <DataGridTextColumn Header="TOTAL NETO" Binding="{Binding TotalNeto, StringFormat=N0}" Width="120" />
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
