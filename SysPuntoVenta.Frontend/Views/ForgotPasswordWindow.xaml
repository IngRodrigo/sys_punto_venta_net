<Window x:Class="SysPuntoVenta.Frontend.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysFacturación - Recuperar Contraseña" 
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}">
    <Border Background="{DynamicResource BrushSurfaceCard}" Margin="16" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="20,16">
        <StackPanel>
            <!-- Cabecera -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="RECUPERAR CONTRASEÑA" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="Enviaremos un código de seguridad de 6 dígitos a tu correo" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Paso 1: Identificación de Usuario/Correo -->
            <StackPanel x:Name="panelPaso1" Margin="0,0,0,10">
                <TextBlock Text="Correo Electrónico o Usuario" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                <TextBox x:Name="txtEmailOUser" Height="29" Margin="0,0,0,10" />
                <Button x:Name="btnEnviarCodigo" Content="Enviar Código de Recuperación" Style="{DynamicResource BtnPrimary}" Height="32" Click="BtnEnviarCodigo_Click" />
            </StackPanel>

            <!-- Paso 2: Validación OTP y Nueva Contraseña (Oculto inicialmente) -->
            <StackPanel x:Name="panelPaso2" Visibility="Collapsed" Margin="0,0,0,10">
                <Border Background="{DynamicResource BrushBadgeBackground}" Padding="10,8" CornerRadius="6" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" Margin="0,0,0,12">
                    <TextBlock x:Name="lblInfoEnvio" Text="Código enviado a tu correo. Revisa tu bandeja de entrada." FontSize="11" Foreground="{DynamicResource BrushPrimary}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Código de 6 Dígitos" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                <TextBox x:Name="txtCodigoOtp" Height="29" Margin="0,0,0,10" MaxLength="6" TextAlignment="Center" FontWeight="Bold" FontSize="14" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nueva Contraseña" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                        <PasswordBox x:Name="txtNuevaPass" Height="29" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Confirmar Contraseña" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                        <PasswordBox x:Name="txtConfirmarPass" Height="29" />
                    </StackPanel>
                </Grid>

                <Button x:Name="btnRestablecer" Content="Restablecer Contraseña" Style="{DynamicResource BtnPrimary}" Height="32" Click="BtnRestablecer_Click" />
            </StackPanel>

            <!-- Mensajes de Estado / Error -->
            <TextBlock x:Name="lblMensaje" Text="" Foreground="{DynamicResource BrushDanger}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap" />

            <!-- Botón Cancelar -->
            <Button x:Name="btnCancelar" Content="Volver al Inicio de Sesión" Style="{DynamicResource BtnOutline}" Height="30" Click="BtnCancelar_Click" />
        </StackPanel>
    </Border>
</Window>
