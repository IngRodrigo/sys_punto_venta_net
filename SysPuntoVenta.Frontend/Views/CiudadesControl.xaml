<UserControl x:Class="SysPuntoVenta.Frontend.Views.CiudadesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="CONFIGURACIÓN DE CIUDADES" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="Mantenimiento de ciudades y regiones del sistema" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Formulario Izquierda Compacto -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurfaceCard}" Margin="0,0,14,0" Padding="16,14" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="● DATOS DE LA CIUDAD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,12" />

                    <TextBlock Text="Nombre / Descripción" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                    <TextBox x:Name="txtDescripcion" Height="29" Margin="0,0,0,8" />

                    <TextBlock Text="País" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                    <ComboBox x:Name="cbPais" Height="29" DisplayMemberPath="Descripcion" SelectedValuePath="Id" Margin="0,0,0,14" />

                    <Button x:Name="btnGuardar" Style="{DynamicResource BtnPrimary}" Height="32" Margin="0,0,0,8" Click="BtnGuardar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="Guardar Ciudad" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnLimpiar" Content="Nuevo / Limpiar" Style="{DynamicResource BtnOutline}" Height="28" Click="BtnLimpiar_Click" />
                </StackPanel>
            </Border>

            <!-- Tabla Derecha -->
            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceCard}" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <DataGrid x:Name="dgCiudades" SelectionChanged="DgCiudades_SelectionChanged" RowHeight="28" FontSize="11.5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                        <DataGridTextColumn Header="CIUDAD" Binding="{Binding Descripcion}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
