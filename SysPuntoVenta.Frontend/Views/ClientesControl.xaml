<UserControl x:Class="SysPuntoVenta.Frontend.Views.ClientesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Minimalista -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="GESTIÓN DE CLIENTES" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="Administración de cartera de clientes para facturación y ventas" 
                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Contenido Dividido -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Formulario Izquierda Compacto y Minimalista -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurfaceCard}" Margin="0,0,14,0" Padding="16,14" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="● DATOS DEL CLIENTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Fila 1: Documento y Teléfono (2 Columnas) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Documento / RUC / CI" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtDocumento" Height="29" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Teléfono / WhatsApp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtTelefono" Height="29" />
                        </StackPanel>
                    </Grid>

                    <!-- Fila 2: Nombre / Razón Social -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Nombre / Razón Social" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                        <TextBox x:Name="txtNombre" Height="29" />
                    </StackPanel>

                    <!-- Fila 3: Dirección -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Dirección" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                        <TextBox x:Name="txtDireccion" Height="29" />
                    </StackPanel>

                    <!-- Fila 4: Correo Electrónico -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Correo Electrónico" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                        <TextBox x:Name="txtEmail" Height="29" />
                    </StackPanel>

                    <!-- Fila 5: País y Ciudad con selección en cascada -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="País" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <ComboBox x:Name="cbPais" Height="29" DisplayMemberPath="Descripcion" SelectedValuePath="Id" SelectionChanged="CbPais_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ciudad" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <ComboBox x:Name="cbCiudad" Height="29" DisplayMemberPath="Descripcion" SelectedValuePath="Id" />
                        </StackPanel>
                    </Grid>

                    <!-- Botones de Acción -->
                    <Button x:Name="btnGuardar" Style="{DynamicResource BtnPrimary}" Height="32" Margin="0,0,0,8" Click="BtnGuardar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Guardar Cliente" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnNuevo" Grid.Column="0" Content="Nuevo / Limpiar" Style="{DynamicResource BtnOutline}" Height="28" Click="BtnNuevo_Click" />
                        <Button x:Name="btnEliminar" Grid.Column="2" Style="{DynamicResource BtnOutline}" BorderBrush="{DynamicResource BrushDanger}" Foreground="{DynamicResource BrushDanger}" Height="28" IsEnabled="False" Click="BtnEliminar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" Margin="0,0,5,0" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="Eliminar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Panel Lista / DataGrid Derecha -->
            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceCard}" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Buscador Compacto -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtBuscar" Height="29" Margin="0,0,8,0" KeyUp="TxtBuscar_KeyUp" />
                        <Button Grid.Column="1" Style="{DynamicResource BtnOutline}" Height="29" Padding="12,0" Click="BtnBuscar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Margin="0,0,5,0" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="Buscar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- DataGrid Clientes Compacto -->
                    <DataGrid Grid.Row="1" x:Name="dgClientes" SelectionChanged="DgClientes_SelectionChanged" RowHeight="28" FontSize="11.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" />
                            <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding Documento}" Width="110" />
                            <DataGridTextColumn Header="NOMBRE / RAZÓN SOCIAL" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="105" />
                            <DataGridTextColumn Header="PAÍS" Binding="{Binding PaisNombre}" Width="85" />
                            <DataGridTextColumn Header="CIUDAD" Binding="{Binding CiudadNombre}" Width="100" />
                            <DataGridTextColumn Header="DIRECCIÓN" Binding="{Binding Direccion}" Width="120" />
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
