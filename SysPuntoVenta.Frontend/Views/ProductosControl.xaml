<UserControl x:Class="SysPuntoVenta.Frontend.Views.ProductosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Minimalista -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="CATÁLOGO DE PRODUCTOS" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="Inventario, precios y cálculo automático de impuestos" 
                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Contenido Dividido -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panel Formulario Compacto -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurfaceCard}" Margin="0,0,14,0" Padding="16,14" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="● DATOS DEL ARTÍCULO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,12" />

                    <!-- Fila 1: Código y Stock -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Código" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtCodigo" Height="29" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stock" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtCantidad" Text="100" Height="29" />
                        </StackPanel>
                    </Grid>

                    <!-- Fila 2: Descripción -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Descripción" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                        <TextBox x:Name="txtDescripcion" Height="29" />
                    </StackPanel>

                    <!-- Fila 3: Precio Bruto e Impuesto 10% -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Precio Bruto (Gs)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtPrecioBruto" Height="29" TextChanged="TxtPrecioBruto_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="IVA 10% (Gs)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushCyan}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtPrecioImpuesto" Height="29" IsReadOnly="True" />
                        </StackPanel>
                    </Grid>

                    <!-- Fila 4: Precio Neto y Tipo Impuesto -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Precio Neto (Total)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,3" />
                            <TextBox x:Name="txtPrecioNeto" Height="29" IsReadOnly="True" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tipo Impuesto" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                            <ComboBox x:Name="cbImpuesto" Height="29" DisplayMemberPath="Descripcion" SelectedValuePath="Id" />
                        </StackPanel>
                    </Grid>

                    <!-- Fila 5: Proveedor -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Proveedor" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3" />
                        <ComboBox x:Name="cbProveedor" Height="29" DisplayMemberPath="RazonSocial" SelectedValuePath="Id" />
                    </StackPanel>

                    <!-- Botones de Acción -->
                    <Button x:Name="btnGuardar" Style="{DynamicResource BtnPrimary}" Height="32" Margin="0,0,0,8" Click="BtnGuardar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Guardar Producto" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnNuevo" Content="Nuevo / Limpiar" Style="{DynamicResource BtnOutline}" Height="28" Click="BtnNuevo_Click" />
                </StackPanel>
            </Border>

            <!-- Panel Lista / DataGrid Derecha -->
            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceCard}" Padding="14,12" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtBuscar" Height="29" Margin="0,0,8,0" KeyUp="TxtBuscar_KeyUp" />
                        <Button Grid.Column="1" Style="{DynamicResource BtnOutline}" Height="29" Padding="12,0" Click="BtnBuscar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Margin="0,0,5,0" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="Buscar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="dgProductos" SelectionChanged="DgProductos_SelectionChanged" RowHeight="28" FontSize="11.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" />
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="100" />
                            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" />
                            <DataGridTextColumn Header="BASE BRUTO" Binding="{Binding Bruto, StringFormat={}{0:N0} Gs}" Width="105" />
                            <DataGridTextColumn Header="IVA 10%" Binding="{Binding PrecioImpuesto, StringFormat={}{0:N0} Gs}" Width="90" />
                            <DataGridTextColumn Header="NETO TOTAL" Binding="{Binding PrecioNeto, StringFormat={}{0:N0} Gs}" Width="110" />
                            <DataGridTextColumn Header="STOCK" Binding="{Binding Cantidad}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
