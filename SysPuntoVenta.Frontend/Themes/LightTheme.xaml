<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PALETA MODERN LIGHT / SLATE & VIOLET -->
    <Color x:Key="ColorBackground">#F1F5F9</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceCard">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#CBD5E1</Color>
    <Color x:Key="ColorPrimary">#7C3AED</Color>
    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#475569</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushSurfaceCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushSurfaceCard2" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BrushBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="BrushBorderLight" Color="#94A3B8" />
    <SolidColorBrush x:Key="BrushPrimary" Color="#7C3AED" />
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="#6D28D9" />
    <SolidColorBrush x:Key="BrushSecondary" Color="#2563EB" />
    <SolidColorBrush x:Key="BrushSecondaryHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="BrushCyan" Color="#0284C7" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#0F172A" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#475569" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B" />
    <SolidColorBrush x:Key="BrushDanger" Color="#DC2626" />
    <SolidColorBrush x:Key="BrushSuccess" Color="#16A34A" />

    <!-- Controles -->
    <SolidColorBrush x:Key="BrushControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushControlForeground" Color="#0F172A" />
    <SolidColorBrush x:Key="BrushReadOnlyBackground" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BrushReadOnlyForeground" Color="#6D28D9" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="BrushDataGridHeader" Color="#EDE9FE" />
    <SolidColorBrush x:Key="BrushDataGridRow" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushDataGridAltRow" Color="#F8FAFC" />

    <!-- Badges e Iconos -->
    <SolidColorBrush x:Key="BrushBadgeBackground" Color="#EDE9FE" />
    <SolidColorBrush x:Key="BrushBadgeBorder" Color="#DDD6FE" />
    <SolidColorBrush x:Key="BrushCardIcon" Color="#EDE9FE" />

    <!-- Gradientes -->
    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0.0" />
        <GradientStop Color="#7C3AED" Offset="0.5" />
        <GradientStop Color="#8B5CF6" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#F8FAFC" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushSidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#F1F5F9" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
